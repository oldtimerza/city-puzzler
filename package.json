{
  "name": "chord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "package:itch": "npm run build && cd dist && zip -r ../chord-itch.zip .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "catalog:typecheck": "tsc --project tsconfig.tools.json",
    "catalog:generate": "tsx tools/generate-puzzle-catalog.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  }
}
